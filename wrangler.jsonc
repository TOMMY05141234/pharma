{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pharma-career-note",
  "compatibility_date": "2026-05-01",
  "observability": {
    "enabled": true
  },
  // 除外は .assetsignore で指定する。
  // assets.exclude は Workers Assets では無効なオプションなので使わないこと。
  "assets": {
    "directory": "."
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
